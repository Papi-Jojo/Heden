{
  "manifest_version": 3,
  "name": "Heden",
  "version": "__VERSION__",
  "homepage_url": "https://papi-jojo.github.io/Heden/",
  "description": "Envoie dans Heden les annonces des pages immobilières que vous ouvrez : listes de résultats et fiches complètes.",
  "icons": {"16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Heden", "default_icon": {"16": "icones/16.png", "32": "icones/32.png"}},
  "background": {"service_worker": "fond.js"},
  "permissions": ["storage", "scripting"],
  "host_permissions": __HEDENM__,
  "content_scripts": [
    {"matches": __HEDENM__, "js": ["pont.js"], "run_at": "document_idle"},
    {"matches": __SITES__, "js": ["ecoute.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": __SITES__, "js": ["lecture.js"], "run_at": "document_idle", "world": "MAIN"},
    {"matches": __SITES__, "js": ["lecteur.js"], "run_at": "document_idle"}
  ]
}
